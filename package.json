{
  "name": "gitecho",
  "type": "module",
  "version": "0.4.11",
  "description": "GitHub/Azure DevOps repository backup tool",
  "engines": {
    "node": "24.x || 26.x",
    "npm": ">=11.19.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local ./node_modules/astro/bin/astro.mjs dev",
    "build": "astro build && node build-worker.mjs",
    "preview": "astro preview",
    "start": "node dist/server/entry.mjs",
    "worker": "node dist/worker/index.mjs",
    "worker:dev": "tsx --env-file-if-exists=.env.local worker/index.ts",
    "test": "tsx --test tests/unit/*.test.ts",
    "seed:demo": "tsx --env-file=.env.demo scripts/seed-demo.ts",
    "screenshots": "playwright test --config=playwright.docs.config.ts",
    "docs:demo": "npm run seed:demo && npm run screenshots"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.11",
    "@astrojs/node": "^11.1.9",
    "@popperjs/core": "^2.11.8",
    "admin-lte": "^4.10.0",
    "archiver": "^8.0.0",
    "astro": "^7.4.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.2",
    "chart.js": "^4.5.1",
    "cronstrue": "^3.36.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.1.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/bootstrap": "^5.2.11",
    "@types/node": "^24.19.2",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "yaml": "^2.9.1",
    "esbuild": "^0.28.2"
  },
  "allowScripts": {
    "better-sqlite3": false
  }
}
